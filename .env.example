# Environment Variables

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — use project ciggiwpztuxkmbaccrlp (Jordan-sketch-hue's Project)
NEXT_PUBLIC_SUPABASE_URL=https://ciggiwpztuxkmbaccrlp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # ← needed for ss_tenants provisioning

# Supreme Suite — workspace base URL and provisioning
NEXT_PUBLIC_SUPREME_SUITE_URL=https://supreme-suite.vercel.app

# WiPay (Jamaica payments)
WIPAY_ACCOUNT_NUMBER=your_wipay_account_number
WIPAY_API_KEY=your_wipay_api_key
WIPAY_ENV=live           # live | sandbox
WIPAY_FEE_STRUCTURE=customer_pay

# Resend (credential emails after purchase)
RESEND_API_KEY=re_your_resend_key
SUITE_FROM_EMAIL=hello@jsupremetech.online

# WhatsApp via Twilio (optional — notifications sent if configured)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886   # your approved Twilio WhatsApp sender

# Legacy / unused
DATABASE_URL=postgresql://user:password@localhost:5432/jsupreme

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Email (Optional - for nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Analytics (Optional)
ANALYTICS_KEY=your_analytics_key

# Google AdSense (monetization) — leave blank until the site is approved.
# Set NEXT_PUBLIC_ADSENSE_CLIENT to your publisher id (ca-pub-XXXXXXXXXXXXXXXX) to
# activate the loader script, /ads.txt, and all ad slots site-wide.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ids (create units in AdSense AFTER approval, then paste here).
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLEFOOT=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=

# Security / CRM Monitoring
# Use long random production values. Security event payloads are encrypted with AES-256-GCM.
SECURITY_ENCRYPTION_KEY=replace-with-a-long-random-production-key
SECURITY_HASH_SALT=replace-with-a-long-random-hash-salt

# Creative / Asset Workflow Integrations
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
MIDJOURNEY_REFERENCE_WORKSPACE_URL=https://your-reference-board-or-folder
GITHUB_REPOSITORY_URL=https://github.com/Jordan-sketch-hue/j-supreme-tech-website
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_ORG_ID=your_vercel_org_id
